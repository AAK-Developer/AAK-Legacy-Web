---
import ContentPage from "@/components/ContentPage.astro";
import { contentPageKeys, getContentPage } from "@/data/pages";
import { pagePaths } from "@/data/site";

export function getStaticPaths() {
  return contentPageKeys.map((key) => ({
    params: { slug: pagePaths.es[key].replace(/^\//, "").replace(/\/$/, "") },
    props: { page: getContentPage("es", key) }
  }));
}

const { page } = Astro.props;
---

<ContentPage page={page} />
