---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import type { ContentPage as Page } from "@/data/pages";
import { pathFor } from "@/data/site";

interface Props { page: Page; }
const { page } = Astro.props;
---

<BaseLayout locale={page.locale} title={page.description} description={page.lead} canonicalPath={page.path} alternatePaths={page.alternatePaths}>
  <div class="site-shell interior-shell">
    <SiteHeader locale={page.locale} currentKey={page.key} alternatePaths={page.alternatePaths} />
    <main id="main">
      <section class={`interior-hero tone-${page.tone}`}>
        <div class="interior-glow" aria-hidden="true"></div>
        <div class="container interior-hero-grid">
          <div>
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p class="interior-lead">{page.lead}</p>
          </div>
          <div class="interior-symbol" aria-hidden="true">
            <span>AAK</span><strong>{String(page.sections.length).padStart(2, "0")}</strong><i></i>
          </div>
        </div>
      </section>

      {page.statement && <section class="statement-band"><div class="container"><blockquote>{page.statement}</blockquote></div></section>}

      <section class={`interior-content ${page.mode === "faq" ? "interior-faq" : ""}`}>
        <div class="container">
          {page.mode === "faq" ? (
            <div class="faq-list interior-faq-list">
              {page.sections.map((section, index) => (
                <details open={index === 0}><summary>{section.title}<span aria-hidden="true"></span></summary><p>{section.text}</p></details>
              ))}
            </div>
          ) : (
            <div class="interior-card-grid">
              {page.sections.map((section, index) => (
                <article class="interior-card">
                  <span>0{index + 1}</span><h2>{section.title}</h2><p>{section.text}</p>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>

      {page.assurance && (
        <section class="privacy-assurance">
          <div class="container privacy-assurance-grid">
            <div class="privacy-assurance-copy">
              <p class="eyebrow eyebrow-light">{page.assurance.eyebrow}</p>
              <h2>{page.assurance.title}</h2>
              <p>{page.assurance.text}</p>
              <a class="button privacy-link" href={pathFor(page.locale, "privacy")}>{page.assurance.linkLabel}<span aria-hidden="true">↗</span></a>
            </div>
            <ul class="privacy-principles">
              {page.assurance.points.map((point, index) => (
                <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{point}</strong></li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {page.sources && page.sourcesTitle && (
        <section class="security-sources">
          <div class="container security-sources-grid">
            <div>
              <p class="eyebrow">AAK · SECURITY</p>
              <h2>{page.sourcesTitle}</h2>
              {page.sourcesIntro && <p>{page.sourcesIntro}</p>}
            </div>
            <ol>
              {page.sources.map((source, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <a href={source.url} target="_blank" rel="noreferrer">{source.label}<b aria-hidden="true">↗</b></a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )}

    </main>
    <SiteFooter locale={page.locale} />
  </div>
</BaseLayout>
