---
import "@/styles/global.css";
import type { Locale } from "@/data/home";
import { assetPath, localeCodes, locales, pathFor, withBase } from "@/data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  ogType?: "website" | "article";
  imagePath?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  extraStructuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { locale, title, description, canonicalPath, alternatePaths, ogType = "website", imagePath = "/assets/brand/og-default.png", publishedTime, modifiedTime, articleTags = [], extraStructuredData } = Astro.props;
const site = "https://aaklegacy.com";
const canonical = new URL(withBase(canonicalPath), site).toString();
const image = new URL(assetPath(imagePath), site).toString();
const isPrivatePreview = import.meta.env.PUBLIC_PREVIEW === "1";
const previewLabels: Record<Locale, string> = {
  es: "Preview privada · No publicada",
  en: "Private preview · Not published",
  fr: "Aperçu privé · Non publié",
  pt: "Pré-visualização privada · Não publicada",
  ca: "Previsualització privada · No publicada"
};
const ogLocales = {
  es: "es_ES",
  en: "en_GB",
  fr: "fr_FR",
  pt: "pt_PT",
  ca: "ca_ES"
} as const;
const allOgLocales = Object.values(ogLocales);

const structuredData: Array<Record<string, unknown>> = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${site}/#organization`,
    name: "AAK Developer",
    url: "https://www.aakdeveloper.com/",
    logo: `${site}${assetPath("/assets/brand/aak-legacy-logo.png")}`
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${site}/#software`,
    name: "AAK Legacy",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS",
    description,
    url: canonical,
    publisher: { "@id": `${site}/#organization` }
  }
];
if (Array.isArray(extraStructuredData)) structuredData.push(...extraStructuredData);
else if (extraStructuredData) structuredData.push(extraStructuredData);
const resolvedAlternates = Object.fromEntries(locales.map((item) => [item, withBase(alternatePaths?.[item] ?? pathFor(item, "home"))])) as Record<Locale, string>;
---

<!doctype html>
<html lang={locale === "pt" ? "pt-PT" : locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A63F5" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="robots" content={isPrivatePreview ? "noindex,nofollow,noarchive,nosnippet" : "index,follow,max-image-preview:large"} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    {locales.map((item) => <link rel="alternate" hreflang={localeCodes[item].hreflang} href={new URL(resolvedAlternates[item], site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(resolvedAlternates.es, site).toString()} />
    <link rel="icon" type="image/png" sizes="64x64" href={assetPath("/assets/brand/favicon-64.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetPath("/assets/brand/apple-touch-icon.png")} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AAK Legacy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocales[locale]} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    {allOgLocales.filter((item) => item !== ogLocales[locale]).map((item) => (
      <meta property="og:locale:alternate" content={item} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    {isPrivatePreview && <div class="private-preview-badge" role="status">{previewLabels[locale]}</div>}
    <slot />
  </body>
</html>
